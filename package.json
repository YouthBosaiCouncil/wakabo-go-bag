{
  "name": "wakabo-go-bag",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev --turbopack",
    "prebuild": "node scripts/check-production.mjs && npm run -s lint",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "cross-env ESLINT_NO_PATCH=1 eslint .",
    "test:integration": "vitest run tests/integration.test.ts",
    "test:emulator": "firebase emulators:exec --project demo-wakabo --only auth,firestore \"npm run test:integration\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "test": "vitest run tests/domain.test.ts tests/legacy.test.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^0.562.0",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.0.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "cross-env": "^10.1.0",
    "eslint": "9.39.2",
    "eslint-config-next": "^16.4.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "firebase-tools": "15.34.1",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  }
}
